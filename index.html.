
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#101827">
  <title>FOCO APROVA | Área de Estudos</title>
  <style>
    :root {
      --bg: #101827;
      --panel: #192538;
      --panel2: #223249;
      --gold: #e6b84a;
      --text: #f4f6fa;
      --muted: #aab6c7;
      --green: #45c486;
      --red: #f07878;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      background: var(--bg);
      color: var(--text);
      font-family: Arial, sans-serif;
    }
    header {
      padding: 22px;
      background: #0b1220;
      border-bottom: 1px solid #34445b;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 12px;
    }
    header h1 { margin: 0; color: var(--gold); letter-spacing: 2px; }
    header p { margin: 5px 0 0; color: var(--muted); }
    .container { max-width: 1150px; margin: auto; padding: 22px; }
    nav { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 22px; }
    button, input, select, textarea {
      font: inherit;
      border-radius: 8px;
      padding: 11px;
    }
    button {
      border: 0;
      background: var(--gold);
      color: #172033;
      font-weight: bold;
      cursor: pointer;
    }
    button:hover { filter: brightness(1.1); }
    nav button { background: var(--panel2); color: white; }
    nav button.active { background: var(--gold); color: #172033; }
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 15px;
    }
    .card {
      background: var(--panel);
      padding: 18px;
      border: 1px solid #34445b;
      border-radius: 13px;
      margin-bottom: 15px;
    }
    .card h3 { margin-top: 0; color: var(--gold); }
    .number { font-size: 30px; font-weight: bold; }
    .muted { color: var(--muted); }
    .progress {
      height: 10px;
      background: #34445b;
      border-radius: 20px;
      overflow: hidden;
      margin: 12px 0;
    }
    .progress div { height: 100%; background: var(--green); width: 0; }
    input, select, textarea {
      width: 100%;
      background: #0f1929;
      color: white;
      border: 1px solid #43536a;
      margin: 6px 0 12px;
    }
    label { color: var(--muted); }
    .hidden { display: none; }
    .task {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 10px 0;
      border-bottom: 1px solid #34445b;
    }
    .task input { width: auto; margin: 0; }
    .task.done span { text-decoration: line-through; color: var(--muted); }
    .timer { font-size: 54px; text-align: center; margin: 15px; }
    .actions { display: flex; flex-wrap: wrap; gap: 8px; }
    .actions button.secondary { background: var(--panel2); color: white; }
    .question { padding: 12px; border-bottom: 1px solid #34445b; }
    .answer { display: block; margin: 8px 0; }
    footer { text-align: center; padding: 25px; color: var(--muted); }
    @media(max-width:600px) {
      .container { padding: 13px; }
      header { padding: 16px; }
      .timer { font-size: 42px; }
    }
  </style>
</head>
<body>
<header>
  <div>
    <h1>FOCO APROVA</h1>
    <p>Disciplina hoje. Aprovação amanhã.</p>
  </div>
  <div class="muted" id="today"></div>
</header>

<main class="container">
  <nav>
    <button class="active" data-page="inicio">Início</button>
    <button data-page="plano">Plano diário</button>
    <button data-page="materias">Matérias</button>
    <button data-page="pomodoro">Pomodoro</button>
    <button data-page="questoes">Questões</button>
    <button data-page="desempenho">Desempenho</button>
    <button data-page="config">Configurações</button>
  </nav>

  <section id="inicio" class="page">
    <div class="card">
      <h2>Seu painel de estudos</h2>
      <p class="muted">Organize sua preparação e acompanhe sua evolução.</p>
    </div>
    <div class="grid">
      <div class="card">
        <h3>Horas estudadas</h3>
        <div class="number" id="hours">0</div>
        <p class="muted">Horas registradas</p>
      </div>
      <div class="card">
        <h3>Questões respondidas</h3>
        <div class="number" id="totalQuestions">0</div>
        <p class="muted">Total de questões</p>
      </div>
      <div class="card">
        <h3>Taxa de acertos</h3>
        <div class="number" id="accuracy">0%</div>
        <p class="muted">Seu aproveitamento</p>
      </div>
      <div class="card">
        <h3>Tarefas concluídas</h3>
        <div class="number" id="completed">0</div>
        <p class="muted">Plano diário</p>
      </div>
    </div>
    <div class="card">
      <h3>Progresso geral</h3>
      <div class="progress"><div id="overallBar"></div></div>
      <span id="overallText" class="muted">0% concluído</span>
    </div>
  </section>

  <section id="plano" class="page hidden">
    <div class="card">
      <h2>Plano diário</h2>
      <p class="muted">Adicione as atividades que precisa cumprir.</p>
      <input id="taskInput" placeholder="Ex.: Estudar Matemática por 1 hora">
      <button onclick="addTask()">Adicionar tarefa</button>
      <div id="taskList"></div>
    </div>
  </section>

  <section id="materias" class="page hidden">
    <div class="card">
      <h2>Matérias</h2>
      <input id="subjectInput" placeholder="Nome da matéria">
      <button onclick="addSubject()">Adicionar matéria</button>
      <div id="subjectList"></div>
    </div>
  </section>

  <section id="pomodoro" class="page hidden">
    <div class="card">
      <h2>Relógio Pomodoro</h2>
      <p class="muted">Estude com foco e faça pausas programadas.</p>
      <div class="timer" id="timer">25:00</div>
      <div class="actions" style="justify-content:center">
        <button onclick="startTimer()">Iniciar</button>
        <button class="secondary" onclick="pauseTimer()">Pausar</button>
        <button class="secondary" onclick="resetTimer()">Reiniciar</button>
      </div>
      <p style="text-align:center">
        <button class="secondary" onclick="setTimer(25)">25 minutos</button>
        <button class="secondary" onclick="setTimer(5)">5 minutos</button>
        <button class="secondary" onclick="setTimer(50)">50 minutos</button>
      </p>
    </div>
  </section>

  <section id="questoes" class="page hidden">
    <div class="card">
      <h2>Registro de questões</h2>
      <label>Quantidade de questões respondidas</label>
      <input id="qTotal" type="number" min="0" placeholder="Ex.: 20">
      <label>Quantidade de acertos</label>
      <input id="qCorrect" type="number" min="0" placeholder="Ex.: 15">
      <button onclick="saveQuestions()">Registrar resultado</button>
      <p id="questionMessage" class="muted"></p>
    </div>
    <div class="card">
      <h3>Questão de exemplo</h3>
      <p>Qual é o resultado de 15 × 4?</p>
      <div class="question">
        <label class="answer"><input type="radio" name="example" value="a"> 45</label>
        <label class="answer"><input type="radio" name="example" value="b"> 60</label>
        <label class="answer"><input type="radio" name="example" value="c"> 75</label>
        <button onclick="checkExample()">Corrigir</button>
        <p id="exampleResult"></p>
      </div>
    </div>
  </section>

  <section id="desempenho" class="page hidden">
    <div class="card">
      <h2>Meu desempenho</h2>
      <p>Horas de estudo: <strong id="performanceHours">0</strong></p>
      <p>Questões respondidas: <strong id="performanceQuestions">0</strong></p>
      <p>Acertos: <strong id="performanceCorrect">0</strong></p>
      <p>Aproveitamento: <strong id="performanceAccuracy">0%</strong></p>
      <label>Registrar horas estudadas</label>
      <input id="studyHours" type="number" min="0" step="0.5" placeholder="Ex.: 1.5">
      <button onclick="addHours()">Salvar horas</button>
    </div>
  </section>

  <section id="config" class="page hidden">
    <div class="card">
      <h2>Configurações</h2>
      <label>Nome do concurso</label>
      <input id="examName" placeholder="Ex.: Concurso militar">
      <label>Data da prova</label>
      <input id="examDate" type="date">
      <label>Meta diária de estudo (horas)</label>
      <input id="dailyGoal" type="number" min="1" value="3">
      <button onclick="saveSettings()">Salvar configurações</button>
      <p id="settingsMessage" class="muted"></p>
    </div>
    <div class="card">
      <h3>Dados do aplicativo</h3>
      <p class="muted">Seus dados ficam salvos neste navegador. Limpar os dados pode apagar seu progresso.</p>
      <button onclick="exportData()">Exportar meus dados</button>
    </div>
  </section>
</main>

<footer>FOCO APROVA • Sua aprovação começa com disciplina.</footer>

<script>
  const $ = id => document.getElementById(id);
  const getData = (key, fallback) => {
    try { return JSON.parse(localStorage.getItem(key)) ?? fallback; }
    catch { return fallback; }
  };
  let tasks = getData("foco_tasks", []);
  let subjects = getData("foco_subjects", []);
  let stats = getData("foco_stats", {hours:0, questions:0, correct:0});
  let settings = getData("foco_settings", {exam:"", date:"", goal:3});

  function save() {
    localStorage.setItem("foco_tasks", JSON.stringify(tasks));
    localStorage.setItem("foco_subjects", JSON.stringify(subjects));
    localStorage.setItem("foco_stats", JSON.stringify(stats));
    localStorage.setItem("foco_settings", JSON.stringify(settings));
    updateDashboard();
  }

  document.querySelectorAll("nav button").forEach(button => {
    button.addEventListener("click", () => {
      document.querySelectorAll("nav button").forEach(b => b.classList.remove("active"));
      document.querySelectorAll(".page").forEach(p => p.classList.add("hidden"));
      button.classList.add("active");
      $(button.dataset.page).classList.remove("hidden");
    });
  });

  function addTask() {
    const value = $("taskInput").value.trim();
    if (!value) return alert("Digite uma tarefa.");
    tasks.push({text:value, done:false});
    $("taskInput").value = "";
    renderTasks(); save();
  }

  function toggleTask(index) {
    tasks[index].done = !tasks[index].done;
    renderTasks(); save();
  }

  function deleteTask(index) {
    tasks.splice(index,1);
    renderTasks(); save();
  }

  function renderTasks() {
    $("taskList").innerHTML = "";
    tasks.forEach((task,index) => {
      const div = document.createElement("div");
      div.className = "task" + (task.done ? " done" : "");
      const check = document.createElement("input");
      check.type = "checkbox";
      check.checked = task.done;
      check.addEventListener("change", () => toggleTask(index));
      const span = document.createElement("span");
      span.textContent = task.text;
      span.style.flex = "1";
      const del = document.createElement("button");
      del.textContent = "Excluir";
      del.className = "secondary";
      del.addEventListener("click", () => deleteTask(index));
      div.append(check,span,del);
      $("taskList").append(div);
    });
  }

  function addSubject() {
    const value = $("subjectInput").value.trim();
    if (!value) return alert("Digite uma matéria.");
    subjects.push(value);
    $("subjectInput").value = "";
    renderSubjects(); save();
  }

  function renderSubjects() {
    $("subjectList").innerHTML = "";
    subjects.forEach((subject,index) => {
      const div = document.createElement("div");
      div.className = "task";
      const span = document.createElement("span");
      span.textContent = subject;
      span.style.flex = "1";
      const del = document.createElement("button");
      del.textContent = "Excluir";
      del.addEventListener("click", () => {
        subjects.splice(index,1);
        renderSubjects(); save();
      });
      div.append(span,del);
      $("subjectList").append(div);
    });
  }

  function saveQuestions() {
    const total = Number($("qTotal").value);
    const correct = Number($("qCorrect").value);
    if (!Number.isInteger(total) || !Number.isInteger(correct) ||
        total < 1 || correct < 0 || correct > total) {
      return alert("Confira os valores. Os acertos não podem superar o total.");
    }
    stats.questions += total;
    stats.correct += correct;
    $("questionMessage").textContent = "Resultado registrado com sucesso!";
    $("qTotal").value = "";
    $("qCorrect").value = "";
    save();
  }

  function addHours() {
    const hours = Number($("studyHours").value);
    if (!Number.isFinite(hours) || hours <= 0) return alert("Digite uma quantidade válida.");
    stats.hours += hours;
    $("studyHours").value = "";
    save();
  }

  function updateDashboard() {
    const accuracy = stats.questions ? Math.round(stats.correct / stats.questions * 100) : 0;
    const completed = tasks.filter(t => t.done).length;
    const progress = tasks.length ? Math.round(completed / tasks.length * 100) : 0;
    $("hours").textContent = stats.hours.toFixed(1);
    $("totalQuestions").textContent = stats.questions;
    $("accuracy").textContent = accuracy + "%";
    $("completed").textContent = completed + "/" + tasks.length;
    $("overallBar").style.width = progress + "%";
    $("overallText").textContent = progress + "% concluído";
    $("performanceHours").textContent = stats.hours.toFixed(1);
    $("performanceQuestions").textContent = stats.questions;
    $("performanceCorrect").textContent = stats.correct;
    $("performanceAccuracy").textContent = accuracy + "%";
  }

  function saveSettings() {
    settings = {
      exam: $("examName").value.trim(),
      date: $("examDate").value,
      goal: Number($("dailyGoal").value)
    };
    save();
    $("settingsMessage").textContent = "Configurações salvas!";
  }

  function exportData() {
    const data = {tasks, subjects, stats, settings};
    const blob = new Blob([JSON.stringify(data,null,2)], {type:"application/json"});
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = "foco-aprova-dados.json";
    a.click();
    URL.revokeObjectURL(url);
  }

  let timerSeconds = 25 * 60;
  let timerInterval = null;

  function showTimer() {
    const min = Math.floor(timerSeconds / 60);
    const sec = timerSeconds % 60;
    $("timer").textContent = String(min).padStart(2,"0") + ":" + String(sec).padStart(2,"0");
  }

  function setTimer(minutes) {
    pauseTimer();
    timerSeconds = minutes * 60;
    showTimer();
  }

  function startTimer() {
    if (timerInterval) return;
    timerInterval = setInterval(() => {
      if (timerSeconds > 0) {
        timerSeconds--;
        showTimer();
      } else {
        pauseTimer();
        alert("Tempo encerrado! Faça uma pausa.");
      }
    },1000);
  }

  function pauseTimer() {
    clearInterval(timerInterval);
    timerInterval = null;
  }

  function resetTimer() { setTimer(25); }

  function checkExample() {
    const selected = document.querySelector('input[name="example"]:checked');
    if (!selected) return alert("Escolha uma alternativa.");
    $("exampleResult").textContent = selected.value === "b"
      ? "Correto! 15 × 4 = 60."
      : "Não foi dessa vez. A resposta correta é 60.";
  }

  $("today").textContent = new Date().toLocaleDateString("pt-BR", {
    weekday:"long", day:"2-digit", month:"long", year:"numeric"
  });

  $("examName").value = settings.exam;
  $("examDate").value = settings.date;
  $("dailyGoal").value = settings.goal;

  renderTasks();
  renderSubjects();
  updateDashboard();
  showTimer();
</script>
</body>
</html>

