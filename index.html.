
<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>FOCO APROVA</title>
<style>
*{box-sizing:border-box}
body{margin:0;font-family:Arial,sans-serif;background:#101827;color:#fff}
header{background:#17243a;padding:25px 15px;text-align:center;border-bottom:3px solid #d6a52c}
header h1{margin:0;color:#f0bd3e;font-size:30px}
header p{color:#cbd5e1}
main{max-width:1000px;margin:auto;padding:20px}
.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px}
.card,.panel{background:#1d2b42;padding:18px;border-radius:12px;margin-bottom:15px}
.card{text-align:center}
.number{font-size:30px;color:#f0bd3e;font-weight:bold}
h2{color:#f0bd3e;font-size:20px}
input,select,button{width:100%;padding:12px;margin:6px 0;border-radius:7px;border:0;font-size:15px}
input,select{background:#f1f5f9;color:#111}
button{background:#d6a52c;color:#101827;font-weight:bold;cursor:pointer}
button:hover{background:#f0bd3e}
.task{background:#263750;padding:12px;border-radius:8px;margin:8px 0;display:flex;justify-content:space-between;gap:10px;align-items:center}
.task button{width:auto;margin:0;padding:8px}
.done{text-decoration:line-through;opacity:.55}
.progress{height:13px;background:#35445b;border-radius:20px;overflow:hidden}
#progressBar{height:100%;width:0;background:#d6a52c}
.timer{text-align:center;font-size:48px;font-weight:bold;color:#f0bd3e;margin:15px}
.small{font-size:13px;color:#bdc8d8}
footer{text-align:center;padding:25px;color:#94a3b8}
</style>
</head>
<body>

<header>
<h1>FOCO APROVA</h1>
<p>Disciplina hoje. Aprovação amanhã.</p>
</header>

<main>
<section class="cards">
<div class="card">
<div class="number" id="totalTasks">0</div>
<div>Tarefas cadastradas</div>
</div>
<div class="card">
<div class="number" id="completedTasks">0</div>
<div>Tarefas concluídas</div>
</div>
<div class="card">
<div class="number" id="totalQuestions">0</div>
<div>Questões resolvidas</div>
</div>
<div class="card">
<div class="number" id="accuracy">0%</div>
<div>Taxa de acertos</div>
</div>
</section>

<section class="panel">
<h2>Meu progresso</h2>
<div class="progress"><div id="progressBar"></div></div>
<p id="progressText">0% concluído</p>
</section>

<section class="panel">
<h2>Adicionar tarefa de estudo</h2>
<input id="subject" placeholder="Matéria (ex.: Português)">
<input id="content" placeholder="O que você vai estudar?">
<input id="studyDate" type="date">
<button onclick="addTask()">Adicionar tarefa</button>
</section>

<section class="panel">
<h2>Minha lista de estudos</h2>
<div id="taskList"></div>
</section>

<section class="panel">
<h2>Registrar questões</h2>
<input id="questions" type="number" min="1" placeholder="Quantidade de questões">
<input id="correct" type="number" min="0" placeholder="Quantidade de acertos">
<button onclick="saveQuestions()">Registrar resultado</button>
<p class="small">Informe quantas questões resolveu e quantas acertou.</p>
</section>

<section class="panel">
<h2>Cronômetro de estudos</h2>
<div class="timer" id="timer">25:00</div>
<button onclick="startTimer()">Iniciar</button>
<button onclick="pauseTimer()">Pausar</button>
<button onclick="resetTimer()">Reiniciar</button>
<p class="small">Método Pomodoro: 25 minutos de foco.</p>
</section>

<section class="panel">
<h2>Backup dos meus dados</h2>
<button onclick="exportData()">Exportar backup</button>
<input type="file" id="backupFile" accept=".json">
<button onclick="importData()">Importar backup</button>
<button onclick="clearData()" style="background:#b94a48;color:white">Apagar todos os dados</button>
</section>
</main>

<footer>FOCO APROVA • Organização, disciplina e constância.</footer>

<script>
const STORAGE_KEY = "focoAprovaDados";

let data = JSON.parse(localStorage.getItem(STORAGE_KEY) || '{"tasks":[],"questions":0,"correct":0}');
let seconds = 1500;
let timerInterval = null;

function saveData(){
 localStorage.setItem(STORAGE_KEY,JSON.stringify(data));
 render();
}

function addTask(){
 const subject=document.getElementById("subject").value.trim();
 const content=document.getElementById("content").value.trim();
 const date=document.getElementById("studyDate").value;

 if(!subject || !content){
  alert("Preencha a matéria e o conteúdo.");
  return;
 }

 data.tasks.push({
  id:Date.now(),
  subject,
  content,
  date,
  done:false
 });

 document.getElementById("subject").value="";
 document.getElementById("content").value="";
 document.getElementById("studyDate").value="";
 saveData();
}

function finishTask(id){
 const task=data.tasks.find(t=>t.id===id);
 if(task) task.done=!task.done;
 saveData();
}

function deleteTask(id){
 data.tasks=data.tasks.filter(t=>t.id!==id);
 saveData();
}

function saveQuestions(){
 const q=Number(document.getElementById("questions").value);
 const c=Number(document.getElementById("correct").value);

 if(!Number.isInteger(q)||!Number.isInteger(c)||q<1||c<0||c>q){
  alert("Confira os números informados.");
  return;
 }

 data.questions+=q;
 data.correct+=c;
 document.getElementById("questions").value="";
 document.getElementById("correct").value="";
 saveData();
}

function render(){
 const list=document.getElementById("taskList");
 list.innerHTML="";

 data.tasks.forEach(task=>{
  const item=document.createElement("div");
  item.className="task";

  const info=document.createElement("div");
  const title=document.createElement("strong");
  title.textContent=task.subject+" — "+task.content;
  if(task.done) title.className="done";
  info.appendChild(title);

  const date=document.createElement("div");
  date.className="small";
  date.textContent=task.date ? "Data: "+task.date : "";
  info.appendChild(date);

  const actions=document.createElement("div");
  const doneBtn=document.createElement("button");
  doneBtn.textContent=task.done?"Desfazer":"Concluir";
  doneBtn.onclick=()=>finishTask(task.id);

  const deleteBtn=document.createElement("button");
  deleteBtn.textContent="Excluir";
  deleteBtn.style.background="#b94a48";
  deleteBtn.style.color="white";
  deleteBtn.onclick=()=>deleteTask(task.id);

  actions.append(doneBtn,deleteBtn);
  item.append(info,actions);
  list.appendChild(item);
 });

 if(data.tasks.length===0){
  list.textContent="Nenhuma tarefa cadastrada ainda.";
 }

 const total=data.tasks.length;
 const completed=data.tasks.filter(t=>t.done).length;
 const progress=total ? Math.round(completed/total*100) : 0;

 document.getElementById("totalTasks").textContent=total;
 document.getElementById("completedTasks").textContent=completed;
 document.getElementById("totalQuestions").textContent=data.questions;
 document.getElementById("accuracy").textContent=
  data.questions ? Math.round(data.correct/data.questions*100)+"%" : "0%";
 document.getElementById("progressBar").style.width=progress+"%";
 document.getElementById("progressText").textContent=progress+"% concluído";
}

function updateTimer(){
 const min=Math.floor(seconds/60);
 const sec=seconds%60;
 document.getElementById("timer").textContent=
  String(min).padStart(2,"0")+":"+String(sec).padStart(2,"0");
}

function startTimer(){
 if(timerInterval) return;
 timerInterval=setInterval(()=>{
  if(seconds>0){
   seconds--;
   updateTimer();
  }else{
   pauseTimer();
   alert("Parabéns! Você concluiu seu período de foco.");
  }
 },1000);
}

function pauseTimer(){
 clearInterval(timerInterval);
 timerInterval=null;
}

function resetTimer(){
 pauseTimer();
 seconds=1500;
 updateTimer();
}

function exportData(){
 const file=new Blob([JSON.stringify(data,null,2)],{type:"application/json"});
 const url=URL.createObjectURL(file);
 const a=document.createElement("a");
 a.href=url;
 a.download="backup-foco-aprova.json";
 a.click();
 URL.revokeObjectURL(url);
}

function importData(){
 const file=document.getElementById("backupFile").files[0];
 if(!file){alert("Selecione um arquivo de backup.");return;}

 const reader=new FileReader();
 reader.onload=()=>{
  try{
   const imported=JSON.parse(reader.result);
   if(!Array.isArray(imported.tasks)) throw new Error();
   data=imported;
   saveData();
   alert("Backup importado!");
  }catch(e){
   alert("Arquivo de backup inválido.");
  }
 };
 reader.readAsText(file);
}

function clearData(){
 if(confirm("Tem certeza que deseja apagar todos os dados?")){
  data={tasks:[],questions:0,correct:0};
  saveData();
 }
}

render();
updateTimer();
</script>
</body>
</html>
